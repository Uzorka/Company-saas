# Copy to .env.local and fill in. Never commit a file with real values.

# Supabase project — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Bypasses Row Level Security — never expose it to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Used to validate redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Static map provider. Not yet chosen — see docs/BACKLOG.md.
# MAP_PROVIDER_API_KEY=""

# Transactional email — https://resend.com/api-keys
#
# Used for the hiring pipeline: shortlist, interview invitation and offer.
# Without these the messages are still composed and kept in outbound_emails,
# and the recruitment screen says plainly that nothing has been delivered.
# They send as soon as a key is present.
#
# EMAIL_FROM must be an address on a domain verified in Resend, or every send
# is rejected. Sending as a gmail.com address will not work.
RESEND_API_KEY=""
EMAIL_FROM="Recruitment <recruitment@yourdomain.com>"
# Where a candidate's reply should go. Optional.
EMAIL_REPLY_TO=""
