# Copy to .env.local and fill in. Never commit a file with real values.

# Supabase project — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Server-only. Bypasses Row Level Security — never expose it to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Used to validate redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Static map provider. Not yet chosen — see docs/BACKLOG.md.
# MAP_PROVIDER_API_KEY=""

# Transactional email — https://resend.com/api-keys
#
# The key is the only part that lives here. It is a credential, so it never
# reaches a browser or a database row.
#
# The sending address and reply-to are the company's own configuration and are
# set in the app: Settings -> Hiring emails. They change without a deploy, and
# each tenant has its own.
#
# The address must be on a domain verified in Resend or every send is rejected;
# a gmail.com address will not work. Until both the key and an address exist,
# messages are still composed and kept, and the recruitment screen says which
# half is missing.
RESEND_API_KEY=""
